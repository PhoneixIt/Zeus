{
  "name": "aios",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "General-purpose AI operating layer for Windows",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "control:audit-routes": "node packages/control-core/audit-injection-routes.mjs",
    "control:proofs": "node packages/control-core/test/run-proof-gate.mjs",
    "control:start": "node packages/control-core/start-operator-host.mjs",
    "control:syntax": "powershell -NoProfile -Command \"& 'C:/Windows/Microsoft.NET/Framework64/v4.0.30319/csc.exe' /target:library /warnaserror+ /out:$env:TEMP/aios-check.dll /reference:'C:/Windows/Microsoft.NET/Framework64/v4.0.30319/System.Windows.Forms.dll' /reference:'C:/Windows/Microsoft.NET/Framework64/v4.0.30319/System.Drawing.dll' packages/control-core/src/*.cs\"",
    "control:up": "node packages/control-core/start-operator-host.mjs",
    "mission:approval": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-approval.ts",
    "mission:durable": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-durable-mission.ts",
    "mission:filesystem": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-filesystem.ts",
    "mission:folder": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-folder-mission.ts",
    "mission:gui-accept": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-gui-accept.ts",
    "mission:gui-audit": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-gui-audit.ts",
    "mission:live": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-live-mission.ts",
    "mission:local": "node --experimental-strip-types --no-warnings packages/mission-engine/live/with-local-model.mjs",
    "mission:local-adversarial": "node --experimental-strip-types --no-warnings packages/mission-engine/live/with-local-model.mjs --only adversarial",
    "mission:model": "node --experimental-strip-types --no-warnings packages/mission-engine/live/with-adversarial-peer.mjs",
    "mission:recovery": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-recovery.ts",
    "mission:review": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-review.ts",
    "mission:terminal": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-terminal.ts",
    "mission:two-step": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-two-step.ts",
    "mission:world-aware": "node --experimental-strip-types --no-warnings packages/mission-engine/live/run-world-aware.ts",
    "model:fetch": "python packages/model/local/fetch-model.py",
    "model:peer": "node --experimental-strip-types --no-warnings packages/model/adversarial-peer.ts 8791",
    "model:serve": "python packages/model/local/server.py --port 8792",
    "test": "node --experimental-strip-types --no-warnings --test \"packages/*/test/*.test.ts\"",
    "typecheck": "node typecheck-gate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
